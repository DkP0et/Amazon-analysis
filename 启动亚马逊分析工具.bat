@echo off
chcp 65001 > nul
title 亚马逊卖家AI分析师 - 一键启动
cls
echo ===================================================
echo      亚马逊卖家 AI 运营分析师 - 本地一键启动器
echo ===================================================
echo.
echo 正在进入工作目录...
cd /d "%~dp0"

echo 正在检查 node_modules 依赖库...
if not exist node_modules (
    echo [状态] 未检测到依赖，正在为您安装依赖（首次运行可能需要 1-2 分钟，请稍候）...
    call npm install
)

echo.
echo [状态] 依赖就绪，正在本地启动服务器...
echo ---------------------------------------------------
echo 启动完成后，请在浏览器中访问: http://localhost:3000
echo ---------------------------------------------------
echo 提示: 如需关闭工具，直接关闭此黑窗口或按 Ctrl+C 即可。
echo ===================================================
echo.

call npm run dev
pause
