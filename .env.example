# DEEPSEEK_API_KEY: 您的 DeepSeek API 密钥，可在 DeepSeek 开放平台申请
DEEPSEEK_API_KEY=

# DEEPSEEK_API_BASE: (可选) 默认为 https://api.deepseek.com/v1。如果是国内中转/自定义接口，请在此配置
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# DEEPSEEK_API_MODEL: (可选) 默认为 deepseek-chat (即 V3/R1 对应的通用对话模型)
DEEPSEEK_API_MODEL=deepseek-chat

# PROXY_URL: (本地开发可选) 代理服务器地址，如 http://127.0.0.1:7890
# 开启此项后，无需开启 TUN 模式也能调用 AI
PROXY_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
